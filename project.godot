; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LAN Fall - Tactical FPS"
run/main_scene="res://scenes/ui/lobby_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PerfSettings="*res://scripts/autoload/perf_settings.gd"
ProfileManager="*res://scripts/autoload/profile_manager.gd"
GameInput="*res://scripts/autoload/game_input.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

common/physics_interpolation=true

[rendering]

renderer/rendering_method.mobile="forward_plus"
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/atlas_size=1024
